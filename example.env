# Notion access token for the Tulio planner agent
NOTION_TOKEN=

# Optional database identifiers. Leave blank to trigger auto provisioning.
NOTION_PLANNER_DATABASE_ID=
NOTION_MIRROR_DATABASE_ID=

# JSON payload describing how to provision databases when IDs are missing.
# Example: {"workspace": "workspace-id", "schema_name": "Tulio Day Planner", "schema": {"Name": {"title": {}}}}
NOTION_PROVISIONING_INSTRUCTIONS=

# Control how the provisioning flow behaves.
NOTION_REUSE_EXISTING_DATABASES=true
NOTION_CREATE_DATABASES=true

# Optional: API key or configuration for Composio MCP if you are using it.
COMPOSIO_API_KEY=

# Optional: assistant slug or identifier when using a Composio orchestrator.
COMPOSIO_ASSISTANT=
